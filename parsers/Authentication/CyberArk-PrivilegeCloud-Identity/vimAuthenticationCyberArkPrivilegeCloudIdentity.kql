let vimAuthenticationCyberArkPrivilegeCloudIdentity = (
        starttime: datetime = datetime(null),
        endtime: datetime = datetime(null),
        username_has_any: dynamic = dynamic([]),
        targetappname_has_any: dynamic = dynamic([]),
        srcipaddr_has_any_prefix: dynamic = dynamic([]),
        srchostname_has_any: dynamic = dynamic([]),
        eventtype_in: dynamic = dynamic([]),
        eventresultdetails_in: dynamic = dynamic([]),
        eventresult: string = "*",
        disabled: bool = false
    ) {
    CyberArk_AuditEvents_CL
    | where not(disabled)
    | where isnull(starttime) or TimeGenerated >= starttime
    | where isnull(endtime) or TimeGenerated <= endtime
    | where component == "Identity"
    | where message in ("cloud.core.login", "cloud.core.logout", "cloud.core.loginfail")
    | extend CustomJson = parse_json(customData)
    | mv-apply item = CustomJson.nested_items on (
        summarize CustomFields = make_bag(pack(tostring(item.name), item.value))
    )
    | extend
        EventType = iff(message == "cloud.core.logout", "Logoff", "Logon"),
        EventResult = iff(message == "cloud.core.loginfail", "Failure", "Success")
    | extend
        EventResultDetails = case(
            EventResult != "Failure", "",
            tostring(CustomFields.failure_reason) has_any ("Challenge not answered", "missing ability to satisfy challenge"), "MFA not satisfied",
            tostring(CustomFields.failure_reason) has "abandoned or expired", "Session expired",
            "Other"
        ),
        EventSeverity = iff(EventResult == "Failure", "Low", "Informational"),
        TargetUsername = username,
        TargetUsernameType = _ASIM_GetUsernameType(username),
        TargetUserType = _ASIM_GetUserType(username, ""),
        SrcIpAddr = tostring(CustomFields.source_ip_address),
        DvcIpAddr = tostring(CustomFields.hostname),
        LogonMethod = iff(tostring(CustomFields.authentication_method) == "MultiAuth", "Multi factor authentication", "Username & Password"),
        LogonProtocol = "HTTPS",
        EventStartTime = TimeGenerated,
        EventEndTime = TimeGenerated,
        EventSchema = "Authentication",
        EventSchemaVersion = "0.1.4",
        EventVendor = "CyberArk",
        EventProduct = "Identity",
        EventSubType = "Remote",
        TargetAppName = "CyberArk Privilege Cloud",
        TargetAppType = "SaaS application",
        LogonTarget = "CyberArk Privilege Cloud",
        EventUid = tostring(hash_sha256(strcat(tostring(TimeGenerated), userId, message, tostring(CustomFields.session_guid)))),
        EventCount = toint(1),
        Type = "CyberArk_AuditEvents_CL"
    | extend
        Dvc = DvcIpAddr,
        Dst = TargetAppName,
        Src = SrcIpAddr,
        DvcAction = iff(EventResult == "Success", "Allowed", "Blocked"),
        Application = TargetAppName,
        IpAddr = SrcIpAddr
    | where (array_length(username_has_any) == 0 or TargetUsername has_any (username_has_any))
        and (array_length(targetappname_has_any) == 0 or TargetAppName has_any (targetappname_has_any))
        and (array_length(srcipaddr_has_any_prefix) == 0 or has_any_ipv4_prefix(SrcIpAddr, srcipaddr_has_any_prefix))
        and array_length(srchostname_has_any) == 0
        and (array_length(eventtype_in) == 0 or EventType in~ (eventtype_in))
        and (array_length(eventresultdetails_in) == 0 or EventResultDetails in~ (eventresultdetails_in))
        and (eventresult == "*" or EventResult =~ eventresult)
    | project
        TimeGenerated,
        EventStartTime,
        EventEndTime,
        EventCount,
        EventType,
        EventSubType,
        EventResult,
        EventResultDetails,
        EventSeverity,
        EventSchema,
        EventSchemaVersion,
        EventVendor,
        EventProduct,
        EventUid,
        Dvc,
        DvcIpAddr,
        DvcAction,
        Dst,
        TargetUsername,
        TargetUsernameType,
        TargetUserType,
        TargetAppName,
        TargetAppType,
        LogonTarget,
        LogonMethod,
        LogonProtocol,
        SrcIpAddr,
        Src,
        Application,
        IpAddr,
        Type
};
