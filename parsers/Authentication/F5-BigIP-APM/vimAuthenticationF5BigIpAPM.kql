// Parameterized (vim) variant of ASimAuthenticationF5BigIpAPM.
// Same session-correlation logic (see ASimAuthenticationF5BigIpAPM.kql for details),
// with standard ASIM filtering parameters added. Time filters run before the
// per-session correlation; the remaining filters run after, since TargetUsername,
// SrcIpAddr and EventResult only exist once lines for a session have been merged.
let vimAuthenticationF5BigIpAPM = (
        starttime: datetime = datetime(null),
        endtime: datetime = datetime(null),
        targetusername_has: string = "",
        srcipaddr_has_any_prefix: dynamic = dynamic([]),
        eventresult_in: dynamic = dynamic([]),
        disabled: bool = false
    ) {
    let RawEvents = Syslog
        | where not(disabled)
        | where isnull(starttime) or TimeGenerated >= starttime
        | where isnull(endtime) or TimeGenerated <= endtime
        | where ProcessName in~ ("apmd", "authd")
        | parse SyslogMessage with MsgId ":" MsgLevel ": /Common/" PolicyName ":Common:" SessionId ": " MsgText
        | extend
            AuthUsername = extract(@"authenticate with '([^']+)' (successfully|failed)", 1, MsgText),
            AuthOutcome = extract(@"authenticate with '([^']+)' (successfully|failed)", 2, MsgText),
            SessionUsername = extract(@"^Username '([^']+)'$", 1, MsgText),
            SessionClientIp = extract(@"clientip is (\S+)$", 1, MsgText),
            SessionTerminalOut = extract(@"terminalout '([^']+)'$", 1, MsgText);
    RawEvents
    | summarize
        EventStartTime = min(TimeGenerated),
        EventEndTime = max(TimeGenerated),
        EventCount = count(),
        Dvc = any(Computer),
        AuthUsername = take_anyif(AuthUsername, isnotempty(AuthUsername)),
        SessionUsername = take_anyif(SessionUsername, isnotempty(SessionUsername)),
        SrcIpAddr = take_anyif(SessionClientIp, isnotempty(SessionClientIp)),
        AuthSuccessCount = countif(AuthOutcome =~ "successfully"),
        AuthFailureCount = countif(AuthOutcome =~ "failed"),
        (LastTerminalOutTime, LastTerminalOut) = arg_max(iff(isnotempty(SessionTerminalOut), TimeGenerated, datetime(null)), SessionTerminalOut)
        by SessionId, PolicyName
    | extend
        TargetUsername = coalesce(AuthUsername, SessionUsername),
        EventResult = case(
            AuthFailureCount > 0, "Failure",
            LastTerminalOut =~ "Deny", "Failure",
            AuthSuccessCount > 0, "Success",
            LastTerminalOut =~ "Allow", "Success",
            "NA"
        )
    | extend
        EventResultDetails = case(
            AuthFailureCount > 0, "Incorrect password",
            LastTerminalOut =~ "Deny", "Logon violates policy",
            ""
        ),
        EventSeverity = iff(AuthFailureCount > 0 or LastTerminalOut =~ "Deny", "Low", "Informational"),
        LogonMethod = iff(PolicyName has_any ("RSA", "Safenet", "MFA"), "Multi factor authentication", "Username & Password"),
        TargetUsernameType = "Simple",
        TargetAppName = PolicyName,
        LogonTarget = PolicyName,
        LogonProtocol = "SSL-VPN",
        EventType = "Logon",
        EventSubType = "Remote",
        EventSchema = "Authentication",
        EventSchemaVersion = "0.1.4",
        EventVendor = "F5",
        EventProduct = "BIG-IP APM",
        EventUid = SessionId,
        Dst = Dvc,
        Src = SrcIpAddr,
        Type = "Syslog"
    | where targetusername_has == "" or TargetUsername has targetusername_has
    | where array_length(srcipaddr_has_any_prefix) == 0 or SrcIpAddr has_any (srcipaddr_has_any_prefix)
    | where array_length(eventresult_in) == 0 or EventResult in (eventresult_in)
    | project
        TimeGenerated = EventEndTime,
        EventStartTime,
        EventEndTime,
        EventCount,
        EventType,
        EventSubType,
        EventResult,
        EventResultDetails,
        EventSeverity,
        EventSchema,
        EventSchemaVersion,
        EventVendor,
        EventProduct,
        EventUid,
        Dvc,
        Dst,
        TargetUsername,
        TargetUsernameType,
        TargetAppName,
        LogonTarget,
        LogonProtocol,
        LogonMethod,
        SrcIpAddr,
        Src,
        Type
};
